# Copy to .env and fill in. .env is gitignored.

# Which backend to use: mock | openai | anthropic
# "mock" runs offline keyword matching with no key and no cost.
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: raises the GitHub API rate limit from 60/h to 5000/h (step 4)
GITHUB_TOKEN=
